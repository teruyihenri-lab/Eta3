    <string name="permission_local_network_title">Qasja në rrjet lokal</string>
    <string name="permission_local_network_summary">Lejo modelet, MCP, shfletuesin e integruar dhe terminalet të kenë qasje në rrjetin lokal kur është e nevojshme. Qasja në internet mbetet e disponueshme pa këtë leje.</string>
    <string name="permission_local_network_denied">Qasja në rrjet lokal nuk u dha. Mund ta lejoni "Aparatet pranë" te cilësimet e lejeve të aplikacionit të sistemit kur të keni nevojë për një servis lokal. Qasja në internet mbetet e disponueshme pa këtë leje.</string>
    <string name="permission_local_network_settings_unavailable">Nuk mund të hapesh cilësimet. Hap lejet e aplikacionit Eta në cilësimet e sistemit për të lejuar "Aparatet pranë".</string>
