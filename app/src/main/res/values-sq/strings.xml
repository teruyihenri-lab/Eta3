    <string name="permission_local_network_title">Qasja në rrjetin lokal</string>
    <string name="permission_local_network_summary">Lejo modelet, MCP, shfletuesin e integruar dhe terminalet të kenë qasje në rrjetin lokal kur të jetë e nevojshme. Qasja në internet mbetet e disponueshme pa këtë leje.</string>
    <string name="permission_local_network_denied">Qasja në rrjetin lokal nuk iu dha. Mund ta lejoni "Aparatet pranë" te cilësimet e lejeve të aplikacionit të sistemit kur të keni nevojë për një shërbim lokal. Qasja në internet mbetet e disponueshme.</string>
    <string name="permission_local_network_settings_unavailable">Nuk mund të hapet konfigurimi. Hap lejet e aplikacionit Eta te cilësimet e sistemit për të lejuar "Aparatet pranë".</string>
